NODE_ENV=development
PORT=5000

DATABASE_URL="postgresql://username:password@localhost:5432/accreditos"
DIRECT_URL="postgresql://username:password@localhost:5432/accreditos"

JWT_SECRET="your_secure_jwt_secret_key"
JWT_EXPIRES_IN="7d"

FRONTEND_URL="http://localhost:8080,https://your-app.vercel.app"

# Real Email OTP SMTP Configuration (Gmail, Outlook, Amazon SES, or custom SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="AccreditOS Security <no-reply@accreditos.com>"
