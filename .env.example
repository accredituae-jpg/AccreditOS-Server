# =====================================================
# AccreditOS Backend — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# =====================================================

# Server
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your-long-random-secret-here
JWT_EXPIRES_IN=30d

# CORS — comma-separated allowed frontend origins
FRONTEND_URL=http://localhost:8080,https://your-deployed-frontend.vercel.app

# -------------------------------------------------------
# DATABASE — Choose ONE set of credentials at a time.
# See PROJECT_CONFIG.md for which DB to use per task.
# -------------------------------------------------------

# Option A: CLIENT Production Database (Supabase ap-southeast-2 Sydney)
# DATABASE_URL=postgresql://postgres.<project-id>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<project-id>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Option B: PERSONAL Development Database (Supabase ap-northeast-1 Tokyo)
# DATABASE_URL=postgresql://postgres.<project-id>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<project-id>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# Active DB (uncomment and fill in one of the above):
DATABASE_URL=
DIRECT_URL=

# -------------------------------------------------------
# AI / External APIs
# -------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# -------------------------------------------------------
# Daily Database Backup (optional)
# -------------------------------------------------------
ENABLE_DAILY_BACKUP=false
BACKUP_DIRECTORY=./backups
BACKUP_TIME=02:00
BACKUP_RETENTION_DAYS=30

# Optional: separate DB URL to test restores against
# DATABASE_RESTORE_URL=
